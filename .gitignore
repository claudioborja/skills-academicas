# Entornos y dependencias locales
.git-local/
**/.runtime/
**/.venv/
**/venv/

# Cachés de Python
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Secretos y configuración privada
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Salidas generadas y temporales
output/
dist/
build/
*.tmp
*.log
.DS_Store
Thumbs.db

# Respaldos históricos locales; no forman parte de la distribución Git
editor-en-jefe/assets/migraciones/*.zip

# Binarios portables: distribuir aparte; conservar el manifiesto de referencia
editor-en-jefe/runtime/python/*
!editor-en-jefe/runtime/python/MANIFEST.json

# Configuración local del agente, no forma parte de las skills distribuidas
/.agents/
/.codex/
